{
  "compilerOptions": {
    "target": "ES5",
    "lib": ["ES5", "DOM"],
    "module": "ES2015",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "build/esm",
    "declaration": true,
    "declarationDir": "dist/types",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitHelpers": true,
    "skipLibCheck": true,
    "types": [],
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"]
}
